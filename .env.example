# ForenCCTV Environment Variables Template
# Copy to .env and configure for your local environment

# Server Configuration
PORT=5000
NODE_ENV=development

# Forensic Security & Write-Block Policy
WRITE_BLOCK_STRICT=true
STORAGE_MOUNT_ROOT=/mnt/forensic_evidence

# Blockchain Node Configuration (Private Ethereum / Hyperledger Fabric)
BLOCKCHAIN_RPC_URI=http://localhost:8545
CHAIN_ID=1337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# AI Inference Service
AI_INFERENCE_ENDPOINT=http://localhost:8000/v1/cv
